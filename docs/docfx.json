{
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "**/obj/**",
          "**/includes/**",
          "_themes/**",
          "_themes.pdf/**",
          "**/docfx.json",
          "_repo.en-us/**",
          "README.md",
          "LICENSE",
          "LICENSE-CODE",
          "ThirdPartyNotices.md",
          "SECURITY.md"
        ],
        "group": "net",
        "src": "."
      }
    ],
    "resource": [
      {
        "files": [
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.gif",
          "**/*.svg"
        ],
        "exclude": [
          "**/obj/**",
          "**/includes/**",
          "_themes/**",
          "_themes.pdf/**",
          "**/docfx.json",
          "_repo.en-us/**"
        ],
        "group": "net",
        "src": "."
      }
    ],
    "overwrite": [],
    "externalReference": [],
    "globalMetadata": {
      "author": "dotnet-bot",
      "breadcrumb_path": "/dotnet/breadcrumb/toc.json",
      "extendBreadcrumb": true,
      "feedback_system": "GitHub",
      "feedback_github_repo": "dotnet/docs-mobile",
      "feedback_product_url": "https://developercommunity.visualstudio.com/",
      "permissioned-type": "public",
      "ms.author": "dotnetcontent",
      "ms.topic": "conceptual",
      "ms.prod": "dotnet-mobile",
      "uhfHeaderId": "MSDocsHeader-DotNet",
    },
    "fileMetadata": {
      "author": {
        "android/**/**.md": "jonpryor",
        "ios/**/**.md": "mandel-macaque"
      },
      "ms.author": {
        "android/**/**.md": "jopryo",
        "ios/**/**.md": "mandel"
      }
      "ms.technology": {
        "android/**/**.md": "dotnet-android",
        "ios/**/**.md": "dotnet-ios"
      }
      "titleSuffix" : {
        "android/**/**.md": ".NET for Android",
        "ios/**/**.md": ".NET for iOS"
      },
      "searchScope": {
        "android/**/**.md": [ ".NET for Android" ],
        "ios/**/**.md": [ ".NET for iOS" ],
      },
    },
    "template": [],
    "dest": "docs-mobile-public",
    "groups": {
      "net": {
        "dest": "net-dest"
      }
    }
  }
}
